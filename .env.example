# ---------------------------------------------------------------------------
# Called It - environment template
# Copy to .env and fill in. NEVER commit .env. This file holds no real values.
# ---------------------------------------------------------------------------

# Frontrun Data API key (hackathon key or Gold plan key).
# Required. Without it the tool refuses to run - it never mocks API responses.
FRONTRUN_API_KEY=

# Base URL of the Frontrun Data API.
# Override only if the hackathon docs give you a different host.
FRONTRUN_BASE_URL=https://api.frontrun.pro

# Name of the HTTP header that carries the API key.
# The hackathon docs specify this; common values: x-api-key, Authorization.
# If it is Authorization, also set FRONTRUN_AUTH_PREFIX=Bearer.
FRONTRUN_AUTH_HEADER=x-api-key
FRONTRUN_AUTH_PREFIX=

# Client-side throttle so we stay inside the documented rate limits.
FRONTRUN_MAX_RPM=60

# Public Solana JSON-RPC used for the read-only on-chain checks.
# Any RPC works. The tool only ever sends read methods - it never signs anything.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# GeckoTerminal public API (no key needed) - used for real historical OHLCV.
GECKOTERMINAL_BASE_URL=https://api.geckoterminal.com/api/v2

# Port for `npm run serve` (local report viewer).
PORT=8788
